---
import planckWebm from "../assets/planck.webm";
import planckMp4 from "../assets/planck.mp4";

interface Props {
    webmSrc?: string;
    mp4Src?: string;
}

const { webmSrc = planckWebm, mp4Src = planckMp4 } = Astro.props;
---

<div class="background-video">
    <video
        id="bg-video"
        autoplay
        muted
        loop
        playsinline
        disablepictureinpicture
        preload="auto"
    >
        {/* Primary: WebM VP9 — browsers pick the first playable source */}
        <source src={webmSrc} type='video/webm; codecs="vp9, opus"' />
        {/* Fallback: MP4 H.264 for browsers without WebM support (e.g. older Safari) */}
        <source src={mp4Src} type='video/mp4; codecs="avc1.42E01E, mp4a.40.2"' />
    </video>
</div>

<style>
    .background-video {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
        overflow: hidden;
    }

    .background-video video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
    }
</style>

<script>
    // Native playback, no HLS: ensure autoplay kicks in even on
    // browsers that need an explicit play() call.
    const video = document.getElementById("bg-video");
    if (video instanceof HTMLVideoElement) {
        const playPromise = video.play();
        if (playPromise instanceof Promise) {
            playPromise.catch(() => {
                /* Autoplay blocked; stays paused until user interaction */
            });
        }
    }
</script>
