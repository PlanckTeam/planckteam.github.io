---
import { SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import PlanckLogo from "../assets/PlanckTeamLogo.png";
import { Icon } from "astro-icon/components";
import MobileSidebar from "./MobileSidebar.astro";
import "../styles/header.css";
import { getRelativeLocaleUrl } from "astro:i18n";
import { i18n } from "astro:config/client";

const locale = Astro.currentLocale ?? i18n?.defaultLocale ?? "";
const url = (path?: string) => getRelativeLocaleUrl(locale, path);
---

<header>
    <nav>
        {/* Left logo and title */}
        <div class="logo-title">
            <Image
                src={PlanckLogo}
                alt="Planck Team Logo"
                height="50"
                loading="eager"
            />
            <h2>
                <a href={url()}>{SITE_TITLE}</a>
            </h2>
        </div>
        {/* Center navigation links */}
        <div class="internal-links">
            <HeaderLink href={url()}>Home</HeaderLink>
            <HeaderLink href={url("/about")}>About us</HeaderLink>
            <HeaderLink href={url("/fll")}>FLL</HeaderLink>
            <HeaderLink href={url("/ftc")}>FTC</HeaderLink>
            <HeaderLink href={url("/blog")}>Blog</HeaderLink>
        </div>
        {/* Right social media icons */}
        <div class="social-links">
            <a href="https://www.instagram.com/planckteam" target="_blank">
                <span class="sr-only"
                    >Join the Planck Team community on Instagram</span
                >
                <Icon
                    name="mdi:instagram"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://www.facebook.com/planckteam" target="_blank">
                <span class="sr-only"
                    >Join the Planck Team community on Facebook</span
                >
                <Icon
                    name="mdi:facebook"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a
                href="https://www.linkedin.com/company/planck-team-italy"
                target="_blank"
            >
                <span class="sr-only"
                    >Join the Planck Team community on LinkedIn</span
                >
                <Icon
                    name="mdi:linkedin"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://www.youtube.com/@PlanckTeam5777" target="_blank">
                <span class="sr-only"
                    >Join the Planck Team community on YouTube</span
                >
                <Icon
                    name="mdi:youtube"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://github.com/PlanckTeam" target="_blank">
                <span class="sr-only"
                    >Join the Planck Team community on GitHub</span
                >
                <Icon
                    name="mdi:github"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
        </div>
        {/* Hamburger button (mobile) */}
        <button
            class="hamburger-btn"
            onclick="window.__openMobileSidebar?.()"
            aria-label="Open navigation menu"
        >
            <Icon name="mdi:menu" width="32" height="32" aria-hidden="true" />
        </button>
    </nav>
</header>
<MobileSidebar />
