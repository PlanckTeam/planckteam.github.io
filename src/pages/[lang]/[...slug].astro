---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("other");

    return posts.map((post) => {
        const [lang, ...slugParts] = post.id.split("/");

        return {
            params: { lang, slug: slugParts.join("/") },
            props: post,
        };
    });
}

type Props = CollectionEntry<"other">;

const { Content } = await render(Astro.props);
const { title, seoTitle, description, heroImage, heroAlt } = Astro.props.data;
---

<Layout title={seoTitle ?? title} description={description}>
    <main>
        <article>
            <div class="hero-image">
                {
                    heroImage && (
                        <Image
                            src={heroImage}
                            width={1020}
                            height={510}
                            alt={heroAlt}
                        />
                    )
                }
            </div>
            <div class="content">
                <h1>{title}</h1>
                <hr />
                <Content />
            </div>
        </article>
    </main>
</Layout>

<style>
    /* Shared styles for content pages (about, fll, ftc, blog posts) */

    main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
    }

    .hero-image {
        display: flex;
        justify-content: center;

        /* astro:assets Image renders the img, so escape scoping */
        :global(img) {
            display: block;
            max-width: 80%;
            max-height: 40vh;
            width: auto;
            height: auto;
            border-radius: 12px;
            box-shadow: var(--box-shadow);
        }
    }

    .content,
    .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: var(--content-color);

        /* Markdown-rendered content lives outside this component, so escape scoping */
        :global(h1) {
            font-size: 2.5em;
        }
    }

    .content :global(h2) {
        margin-top: 1.5em;
    }

    .content :global(a) {
        color: var(--accent);
    }

    /* Markdown typography (unclassed HTML rendered by <Content />) */
    .content :global(h1),
    .content :global(h2),
    .content :global(h3),
    .content :global(h4),
    .content :global(h5),
    .content :global(h6) {
        margin: 0 0 0.5rem 0;
        color: rgb(var(--black));
        line-height: 1.2;
    }

    .content :global(h2) {
        font-size: 2.441em;
    }

    .content :global(h3) {
        font-size: 1.953em;
    }

    .content :global(h4) {
        font-size: 1.563em;
    }

    .content :global(h5) {
        font-size: 1.25em;
    }

    .content :global(p) {
        margin-bottom: 1em;
    }

    .content :global(a:hover) {
        color: var(--accent);
        filter: brightness(1.2);
        text-decoration: underline;
    }

    .dark .content :global(a:hover) {
        color: var(--accent);
        filter: brightness(1.3);
    }

    .content :global(strong),
    .content :global(b) {
        font-weight: 700;
    }

    .content :global(table) {
        width: 100%;
    }

    .content :global(code) {
        padding: 2px 5px;
        background-color: rgb(var(--gray-light));
        border-radius: 2px;
    }

    .content :global(pre) {
        padding: 1.5em;
        border-radius: 8px;
    }

    .content :global(pre code) {
        all: unset;
    }

    .content :global(blockquote) {
        border-left: 4px solid var(--accent);
        padding: 0 0 0 20px;
        margin: 0;
        font-size: 1.333em;
    }

    .content :global(hr) {
        border: none;
        border-top: 1px solid rgb(var(--gray-light));
    }
</style>
