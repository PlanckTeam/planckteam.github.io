---
import { Icon } from "astro-icon/components";
import ThemeToggle from "./ThemeToggle.astro";
import t from "../i18n/strings";
const today = new Date();
---

<footer>
    {today.getFullYear()} - Planck Team, {t("footer_tagline", Astro.currentLocale!)}.
    <div class="social-links">
        <a href="https://www.instagram.com/planckteam" target="_blank">
            <span class="sr-only"
                >{t("header_instagram", Astro.currentLocale!)}</span
            >
            <Icon
                name="mdi:instagram"
                width="32"
                height="32"
                aria-hidden="true"
            />
        </a>
        <a href="https://www.facebook.com/planckteam" target="_blank">
            <span class="sr-only"
                >{t("header_facebook", Astro.currentLocale!)}</span
            >
            <Icon
                name="mdi:facebook"
                width="32"
                height="32"
                aria-hidden="true"
            />
        </a>
        <a
            href="https://www.linkedin.com/company/planck-team-italy"
            target="_blank"
        >
            <span class="sr-only"
                >{t("header_linkedin", Astro.currentLocale!)}</span
            >
            <Icon
                name="mdi:linkedin"
                width="32"
                height="32"
                aria-hidden="true"
            />
        </a>
        <a href="https://www.youtube.com/@PlanckTeam5777" target="_blank">
            <span class="sr-only"
                >{t("header_youtube", Astro.currentLocale!)}</span
            >
            <Icon
                name="mdi:youtube"
                width="32"
                height="32"
                aria-hidden="true"
            />
        </a>
        <a href="https://github.com/PlanckTeam" target="_blank">
            <span class="sr-only">{t("header_github", Astro.currentLocale!)}</span
            >
            <Icon name="mdi:github" width="32" height="32" aria-hidden="true" />
        </a>
    </div>
    <ThemeToggle />
</footer>
<style>
    footer {
        padding: 2em 1em 6em 1em;
        background: linear-gradient(var(--gray-gradient)) no-repeat;
        color: rgb(var(--gray));
        text-align: center;
    }
    .social-links {
        display: flex;
        justify-content: center;
        gap: 1em;
        margin: 1em 0;

        a {
            text-decoration: none;
            color: rgb(var(--gray));
        }
        a:hover {
            color: var(--footer-link-hover);
        }
    }
</style>
