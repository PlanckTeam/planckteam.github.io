---
import { SITE_TITLE } from "../consts";
import { Image } from "astro:assets";
import HeaderLink from "./HeaderLink.astro";
import PlanckLogo from "../assets/PlanckTeamLogo.png";
import { Icon } from "astro-icon/components";
import MobileSidebar from "./MobileSidebar.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import t from "../i18n/strings";

const url = (path?: string) => getRelativeLocaleUrl(Astro.currentLocale!, path);
---

<header>
    <nav>
        {/* Left logo and title */}
        <div class="logo-title">
            <Image
                src={PlanckLogo}
                alt="Planck Team Logo"
                height="50"
                loading="eager"
            />
            <h2>
                <a class="site-title" href={url()}>{SITE_TITLE}</a>
            </h2>
        </div>
        {/* Center navigation links */}
        <div class="internal-links">
            <HeaderLink href={url()}>Home</HeaderLink>
            <HeaderLink href={url("/about")}>
                {t("header_about", Astro.currentLocale!)}
            </HeaderLink>
            <HeaderLink href={url("/fll")}>FLL</HeaderLink>
            <HeaderLink href={url("/ftc")}>FTC</HeaderLink>
            <HeaderLink href={url("/blog")}>Blog</HeaderLink>
        </div>
        {/* Right social media icons */}
        <div class="social-links">
            <a href="https://www.instagram.com/planckteam" target="_blank">
                <span class="sr-only">
                    {t("header_instagram", Astro.currentLocale!)}
                </span>
                <Icon
                    name="mdi:instagram"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://www.facebook.com/planckteam" target="_blank">
                <span class="sr-only">
                    {t("header_facebook", Astro.currentLocale!)}
                </span>
                <Icon
                    name="mdi:facebook"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a
                href="https://www.linkedin.com/company/planck-team-italy"
                target="_blank"
            >
                <span class="sr-only">
                    {t("header_linkedin", Astro.currentLocale!)}
                </span>
                <Icon
                    name="mdi:linkedin"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://www.youtube.com/@PlanckTeam5777" target="_blank">
                <span class="sr-only">
                    {t("header_youtube", Astro.currentLocale!)}
                </span>
                <Icon
                    name="mdi:youtube"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
            <a href="https://github.com/PlanckTeam" target="_blank">
                <span class="sr-only">
                    {t("header_github", Astro.currentLocale!)}
                </span>
                <Icon
                    name="mdi:github"
                    width="32"
                    height="32"
                    aria-hidden="true"
                />
            </a>
        </div>
        {/* Hamburger button (mobile) */}
        <button
            class="hamburger-btn"
            onclick="window.__openMobileSidebar?.()"
            aria-label={t("sidebar_open", Astro.currentLocale!)}
        >
            <Icon name="mdi:menu" width="32" height="32" aria-hidden="true" />
        </button>
    </nav>
</header>
<MobileSidebar />

<style>
    header {
        margin: 0;
        padding: 0 1em;
        background: var(--header-bg);
        box-shadow: var(--header-shadow);
    }

    h2 {
        position: relative;
        margin: 0;
        color: rgb(var(--black));
        line-height: 1.2;
        font-size: 1.5em;
        font-family: var(--font-quicksand);
        font-weight: 300;
        /* Make the text slightly wider, Quicksand doesn't support it via the "wdht" parameter + compensate for border */
        transform: scaleX(1.2) translateY(-3px);
    }

    /* Title link: own class so no other anchor rule can fight over its border */
    .site-title {
        position: relative;
        text-decoration: none;
        padding: 0 0;
        margin: 0 1em;
        border-bottom: 3px solid;
        border-image: linear-gradient(
            to right,
            #009246 0 33.333%,
            #ffffff 33.333% 66.666%,
            #ce2b37 66.666% 100%
        ) 1;
    }

    /* No hover reaction on the title (stays clickable with pointer cursor) */
    .site-title:hover {
        color: inherit;
        filter: none;
        text-decoration: none;
    }

    nav {
        display: flex;
        align-items: center;
        justify-content: space-between;

        /* HeaderLink renders the anchors, so escape scoping.
           (Its .active state is styled by HeaderLink itself.) */
        :global(a) {
            padding: 1em 0.5em;
            color: var(--black);
            border-bottom: 4px solid transparent;
            text-decoration: none;
        }

        :global(a:hover) {
            color: var(--accent);
            filter: brightness(1.2);
        }
    }

    .logo-title {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5em;

        /* astro:assets Image renders the img, so escape scoping */
        :global(img) {
            border-radius: 0;
        }
    }

    .internal-links {
        display: flex;
        gap: 0.5em;
    }

    .social-links {
        flex: 1;
        display: flex;
        justify-content: flex-end;

        a {
            display: flex;
        }
    }

    /* Hamburger button */
    .hamburger-btn {
        display: none;
        border: 0;
        background: none;
        cursor: pointer;
        color: rgb(var(--black));
        padding: 0.5em;
        margin-left: 0.5em;
    }

    /* Mobile layout */
    @media (max-width: 720px) {
        header {
            padding: 1em 1em;
        }
        .internal-links {
            display: none;
        }

        .social-links {
            display: none;
        }

        .hamburger-btn {
            display: flex;
            align-items: center;
        }
    }
</style>
