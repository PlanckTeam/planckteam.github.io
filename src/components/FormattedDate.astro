---
interface Props {
    date: Date;
}

const { date } = Astro.props;
---

<time datetime={date.toISOString()}>
    {
        date.toLocaleDateString(Astro.currentLocale === "it" ? "it-IT" : "en-US", {
            year: "numeric",
            month: "short",
            day: "numeric",
        })
    }
</time>
