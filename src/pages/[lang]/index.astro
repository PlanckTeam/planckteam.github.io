---
import VideoPlayer from "../../components/VideoPlayer.astro";
import Layout from "../../layouts/Layout.astro";
import t from "../../i18n/strings";
import { i18n } from "astro:config/client";
import { getRelativeLocaleUrl } from "astro:i18n";

export function getStaticPaths() {
    return i18n?.locales.map((locale) => ({
        params: { lang: locale },
    }));
}
---

<Layout>
    <VideoPlayer />

    <main class="hero">
        <section>
            <h1>
                <span style="color: var(--planck-blue-light)">PLANCK</span>
                <span style="color: var(--planck-red)">TEAM</span>
            </h1>
            <p>{t("index_standard", Astro.currentLocale!)}</p>
            <a
                id="divein"
                href={getRelativeLocaleUrl(Astro.currentLocale!, "/about")}
            >
                {t("index_diveIn", Astro.currentLocale!)}
            </a>
        </section>
    </main>
</Layout>

<style>
    /* Applies to this page only (body is rendered by Layout, so escape scoping) */
    :global(body) {
        display: flex;
        flex-direction: column;
        height: 100vh;
        margin: 0;
        overflow-x: hidden;
    }

    .hero {
        display: flex;
        flex: 1;
        width: 100%;
        justify-content: center;
        align-items: center;
        text-align: center;
        color: white;
        background-color: rgba(0, 0, 0, 0.45);

        min-height: calc(80vh);

        h1 {
            font-family: var(--font-membra);
            color: white;
            font-size: 4em;
            font-weight: 500;
            margin: 0 0 0.5rem 0;
            line-height: 1.2;
            text-shadow:
                0 0 8px rgba(0, 0, 0, 0.6),
                2px 2px 4px rgba(0, 0, 0, 0.4);
        }

        p {
            margin-bottom: 1em;
        }
    }

    #divein {
        padding: 12px 24px;
        color: white;
        background-color: var(--planck-blue-light);
        border: none;
        border-radius: 12px;
        cursor: pointer;
        transition: background-color 0.3s ease;
        text-decoration: none;
        /* Preserve the font-size from when this was a btn */
        font-size: 13.33px;
        box-shadow: var(--divein-shadow);

        &:hover {
            background-color: var(--planck-red);
            filter: brightness(1.2);
        }
    }
</style>
