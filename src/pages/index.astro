<script>
    import { i18n } from "astro:config/client";
    const locals = i18n?.locales ?? [];
    const validLangs = navigator.languages
        .map((l) => l.split("-")[0] ?? "")
        .filter((l) => locals.includes(l));
    const lang = validLangs[0] ?? "en";
    window.location.pathname = lang;
</script>
