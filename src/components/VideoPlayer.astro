---
interface Props {
    src: string;
}

const { src } = Astro.props;
import "plyr/dist/plyr.css";
---

<div class="background-video">
    <video
        id="ff-stream-player"
        data-src={src}
        crossorigin="anonymous"
        muted
        autoplay
        loop
        playsinline
        disablepictureinpicture
    >
    </video>
</div>

<style>
    .background-video {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: -1;
        overflow: hidden;
    }

    .background-video video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        object-position: center top;
    }

    /* Make sure Plyr container also fills the viewport */
    /* (.plyr nodes are injected by Plyr.js at runtime, so escape scoping) */
    .background-video :global(.plyr),
    .background-video :global(.plyr__video-wrapper) {
        width: 100%;
        height: 100%;
    }

    .background-video :global(.plyr) {
        position: absolute;
        top: 0;
        left: 0;
    }
</style>

<script>
    import Hls from "hls.js";
    import Plyr from "plyr";

    function initPlayer() {
        const video = document.getElementById(
            "ff-stream-player",
        ) as HTMLVideoElement;
        if (!video) return;

        const streamSource = video.dataset.src;
        if (!streamSource) return;

        const plyrOptions = {
            controls: [],
            settings: ["quality", "speed"],
        };

        if (Hls.isSupported()) {
            const hlsInstance = new Hls({
                maxMaxBufferLength: 10,
                // Firefox specific: retry more aggressively if a segment load gets dropped
                manifestLoadingMaxRetry: 4,
                levelLoadingMaxRetry: 4,
            });

            hlsInstance.loadSource(streamSource);
            hlsInstance.attachMedia(video);

            hlsInstance.on(Hls.Events.MANIFEST_PARSED, () => {
                new Plyr(video, plyrOptions);
            });

            // Handle Firefox buffer stalls gracefully
            hlsInstance.on(Hls.Events.ERROR, function (_event, data) {
                if (data.fatal) {
                    switch (data.type) {
                        case Hls.ErrorTypes.NETWORK_ERROR:
                            hlsInstance?.startLoad();
                            break;
                        case Hls.ErrorTypes.MEDIA_ERROR:
                            hlsInstance?.recoverMediaError();
                            break;
                    }
                }
            });
        } else if (video.canPlayType("application/vnd.apple.mpegurl")) {
            video.src = streamSource;
            new Plyr(video, plyrOptions);
        }
    }

    document.addEventListener("DOMContentLoaded", initPlayer, { once: true });
</script>
