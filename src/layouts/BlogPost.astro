---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import FormattedDate from "../components/FormattedDate.astro";
import Header from "../components/Header.astro";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: title,
    description: description,
    image: heroImage ? new URL(heroImage.src, Astro.site).href : undefined,
    datePublished: pubDate.toISOString(),
    dateModified: (updatedDate ?? pubDate).toISOString(),
    author: {
        "@type": "Organization",
        name: "Planck Team",
        url: "https://planckteam.github.io",
    },
};
---

<html lang={Astro.currentLocale}>
    <head>
        <BaseHead title={title} description={description} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(jsonLd)}
        />
    </head>

    <body>
        <Header />
        <main>
            <article>
                <div class="hero-image">
                    {
                        heroImage && (
                            <Image
                                width={1020}
                                height={510}
                                src={heroImage}
                                alt={title}
                            />
                        )
                    }
                </div>
                <div class="prose">
                    <div class="title">
                        <div class="date">
                            <FormattedDate date={pubDate} />
                            {
                                updatedDate && (
                                    <div class="last-updated-on">
                                        Last updated on{" "}
                                        <FormattedDate date={updatedDate} />
                                    </div>
                                )
                            }
                        </div>
                        <h1>{title}</h1>
                        <hr />
                    </div>
                    <slot />
                </div>
            </article>
        </main>
        <Footer />
    </body>
</html>

<style>
    /* Shared styles for content pages (about, fll, ftc, blog posts) */

    main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
    }

    .hero-image {
        display: flex;
        justify-content: center;

        /* astro:assets Image renders the img, so escape scoping */
        :global(img) {
            display: block;
            max-width: 80%;
            max-height: 40vh;
            width: auto;
            height: auto;
            border-radius: 12px;
            box-shadow: var(--box-shadow);
        }
    }

    .content,
    .prose {
        width: 720px;
        max-width: calc(100% - 2em);
        margin: auto;
        padding: 1em;
        color: var(--content-color);

        /* Markdown-rendered content lives outside this component, so escape scoping */
        :global(h1) {
            font-size: 2.5em;
        }
    }

    .content :global(h2) {
        margin-top: 1.5em;
    }

    .content :global(a) {
        color: var(--accent);
    }

    /* Markdown typography (unclassed HTML rendered by <Content />) */
    .prose :global(h1),
    .prose :global(h2),
    .prose :global(h3),
    .prose :global(h4),
    .prose :global(h5),
    .prose :global(h6) {
        margin: 0 0 0.5rem 0;
        color: rgb(var(--black));
        line-height: 1.2;
    }

    .prose :global(h2) {
        font-size: 2.441em;
    }

    .prose :global(h3) {
        font-size: 1.953em;
    }

    .prose :global(h4) {
        font-size: 1.563em;
    }

    .prose :global(h5) {
        font-size: 1.25em;
    }

    .prose :global(p) {
        margin-bottom: 2em;
    }

    .prose :global(a:hover) {
        color: var(--accent);
        filter: brightness(1.2);
        text-decoration: underline;
    }

    .dark .prose :global(a:hover) {
        color: var(--accent);
        filter: brightness(1.3);
    }

    .prose :global(strong),
    .prose :global(b) {
        font-weight: 700;
    }

    .prose :global(table) {
        width: 100%;
    }

    .prose :global(code) {
        padding: 2px 5px;
        background-color: rgb(var(--gray-light));
        border-radius: 2px;
    }

    .prose :global(pre) {
        padding: 1.5em;
        border-radius: 8px;
    }

    .prose :global(pre code) {
        all: unset;
    }

    .prose :global(blockquote) {
        border-left: 4px solid var(--accent);
        padding: 0 0 0 20px;
        margin: 0;
        font-size: 1.333em;
    }

    .prose :global(hr) {
        border: none;
        border-top: 1px solid rgb(var(--gray-light));
    }

    .title {
        margin-bottom: 1em;
        padding: 1em 0;
        text-align: center;
        line-height: 1;
    }

    .title h1 {
        font-size: 2.5em;
        margin: 0 0 0.5em 0;
    }

    .date {
        margin-bottom: 0.5em;
        color: rgb(var(--gray));
    }

    .last-updated-on {
        font-style: italic;
    }
</style>
