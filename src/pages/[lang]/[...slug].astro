---
import { Image } from "astro:assets";
import { getCollection, render, type CollectionEntry } from "astro:content";
import "../../styles/content.css";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const posts = await getCollection("other");

    return posts.map((post) => {
        const [lang, ...slugParts] = post.id.split("/");

        return {
            params: { lang, slug: slugParts.join("/") },
            props: post,
        };
    });
}

type Props = CollectionEntry<"other">;

const { Content } = await render(Astro.props);
const { title, seoTitle, description, heroImage, heroAlt } = Astro.props.data;
---

<Layout title={seoTitle ?? title} description={description}>
    <main>
        <article>
            <div class="hero-image">
                {
                    heroImage && (
                        <Image
                            src={heroImage}
                            width={1020}
                            height={510}
                            alt={heroAlt}
                        />
                    )
                }
            </div>
            <div class="content">
                <h1>{title}</h1>
                <hr />
                <Content />
            </div>
        </article>
    </main>
</Layout>

<style>
    /* Content typography lives in ../../styles/content.css;
       only the page-level main override stays here. */
    main {
        width: calc(100% - 2em);
        max-width: 100%;
        margin: 0;
    }
</style>
