---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_SEO_TITLE } from "../consts";
import PlanckLogo from "../assets/PlanckTeamLogo.png";

interface Props {
    children: unknown;
}

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "EducationalOrganization",
    name: "Planck Team",
    description: SITE_DESCRIPTION,
    url: "https://planckteam.github.io",
    logo: new URL(PlanckLogo.src, Astro.site).href,
    foundingDate: "2014",
    address: {
        "@type": "PostalAddress",
        addressLocality: "Villorba",
        addressRegion: "Treviso",
        addressCountry: "IT",
    },
    sameAs: [
        "https://www.instagram.com/planckteam",
        "https://www.facebook.com/planckteam",
        "https://www.linkedin.com/company/planck-team-italy",
        "https://www.youtube.com/@PlanckTeam5777",
        "https://github.com/PlanckTeam",
    ],
};
---

<!doctype html>
<html lang={Astro.currentLocale}>
    <head>
        <BaseHead title={SITE_SEO_TITLE} description={SITE_DESCRIPTION} />
        <script
            type="application/ld+json"
            is:inline
            set:html={JSON.stringify(jsonLd)}
        />
        <meta
            name="google-site-verification"
            content="raRAcHFcxLgnO82ewnM1faeV6mm6pSTRD2puJ8yvCHo"
        />
    </head>
    <body>
        <Header />
        <slot />
        <Footer />
    </body>
</html>
